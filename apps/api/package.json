{
  "name": "@loboflow/api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS e worker de jobs do LoboFlow (mesmo código, processos separados).",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "nest start --watch --preserveWatchOutput",
    "dev:worker": "nest start --watch --preserveWatchOutput --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node dist/scripts/migrate.js",
    "db:seed": "node dist/scripts/seed.js",
    "superadmin:create": "node dist/scripts/create-superadmin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@google/genai": "^1.52.0",
    "@loboflow/shared": "workspace:*",
    "@loboflow/validation": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.61.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "multer": "^2.0.2",
    "nestjs-pino": "^4.4.1",
    "nodemailer": "^7.0.9",
    "openai": "^5.23.2",
    "pino": "^9.13.1",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.13.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.8",
    "@types/nodemailer": "^7.0.2",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.37.0",
    "pino-pretty": "^13.1.1",
    "prisma": "^6.19.3",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}
