# ==============================================================================
# LOBOFLOW — VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Copie este arquivo para .env no ambiente de desenvolvimento ou configure
# as variáveis correspondentes no painel de ambiente do EasyPanel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Aplicação e Servidor
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=LoboFlow
APP_URL=http://localhost:5173
API_PREFIX=/api/v1
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false
SWAGGER_ENABLED=true

# ------------------------------------------------------------------------------
# 2. Banco de Dados (PostgreSQL)
# ------------------------------------------------------------------------------
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/loboflow?schema=public

# ------------------------------------------------------------------------------
# 3. Cache, Filas e Coordenação (Redis - Opcional em Dev, Recomendado em Prod)
# ------------------------------------------------------------------------------
# Em dev sem Redis, os eventos ficam na tabela outbox do PostgreSQL.
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 4. Segurança e Criptografia (OBRIGATÓRIO CONFIGURAR EM PRODUÇÃO)
# ------------------------------------------------------------------------------
# Chave de sessão para cookies e tokens (mínimo 32 caracteres)
SESSION_SECRET=dev-session-secret-change-in-production-min-32-chars

# Chave simétrica AES-256-GCM para dados sensíveis (32 bytes em Base64)
# Gere no terminal com: openssl rand -base64 32
ENCRYPTION_KEY=dGhpc2lzYWR1bW15ZW5jcnlwdGlvbmtleWZvcmRldjEyMzQ=

# Duração da sessão em dias
SESSION_TTL_DAYS=14

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Políticas de cadastro e verificação
ALLOW_PUBLIC_SIGNUP=true
REQUIRE_EMAIL_VERIFICATION=false

# ------------------------------------------------------------------------------
# 5. Armazenamento de Arquivos e Documentos (S3 / MinIO)
# ------------------------------------------------------------------------------
# Opções: 'none' (desativado/memória local), 'minio', 's3'
STORAGE_PROVIDER=none
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=loboflow-files
S3_ACCESS_KEY=loboflow
S3_SECRET_KEY=loboflow_dev_secret
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_MB=25

# ------------------------------------------------------------------------------
# 6. E-mail (SMTP Global / Fallback)
# ------------------------------------------------------------------------------
# Podem ser configurados também pelo painel SuperAdmin ou por cada organização.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@loboflow.com.br
SMTP_FROM_NAME=LoboFlow

# ------------------------------------------------------------------------------
# 7. Assistente de IA (Jarvis) — Provedores Globais Opcionais
# ------------------------------------------------------------------------------
AI_DEFAULT_PROVIDER=GEMINI
AI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 8. Webhooks e Worker
# ------------------------------------------------------------------------------
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
WORKER_CONCURRENCY=5
